# Runtime
API_PORT=8080
SANDBOXD_ADDR=127.0.0.1:9090
SANDBOX_BACKEND=container        # container | microvm
MODEL_MODE=live                  # live | replay | mock
MODEL_PROVIDER=openai-compatible # any OpenAI-compatible endpoint
MODEL_BASE_URL=
MODEL_API_KEY=                   # never commit
MODEL_NAME=
# Limits (defaults; policy files may be stricter)
RUN_TIMEOUT_SECONDS=600
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEM_MB=512
SANDBOX_PIDS_MAX=256
# Decision layer (optional)
DECISION_PROVIDER=rules          # rules | llm | jev | replay
JEV_API_BASE=
JEV_API_KEY=
JEV_MODEL=
DECISION_ESCALATE_ABOVE=0.5
# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
