{
  "name": "agent-sandbox-platform-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "sandbox-engine",
    "ui"
  ],
  "scripts": {
    "setup": "npm install",
    "build": "npm run build --workspaces --if-present",
